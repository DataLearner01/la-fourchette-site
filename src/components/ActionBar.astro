---
// Phones only: the three things a guest wants, within reach of the thumb.
import { routes, type Lang, type PageKey } from '../data/routes';
import { common, demo } from '../data/site';

interface Props {
  lang: Lang;
  page: PageKey | null;
}
const { lang, page } = Astro.props;
const t = common[lang];
// On the reservation page the button jumps to the form instead of reloading the page.
const reserveHref = page === 'reservation' ? '#reserver' : routes.reservation[lang];
---

<nav class="action-bar" aria-label={t.quickActions} data-theme="dark">
  <a class="action-bar__primary" href={reserveHref}>{t.reserveShort}</a>
  <a href={demo.whatsapp}>WhatsApp</a>
  <a href={demo.phone.href}>{t.callShort}</a>
</nav>

<style>
  .action-bar {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    padding-bottom: env(safe-area-inset-bottom);
    border-top: 1px solid var(--rule);
    view-transition-name: action-bar;
  }

  .action-bar a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
  }

  .action-bar a + a {
    border-left: 1px solid var(--rule);
  }

  .action-bar a:active {
    background: rgb(255 255 255 / 0.08);
  }

  .action-bar__primary {
    background: var(--noeud);
    color: #000;
  }

  .action-bar a.action-bar__primary:active {
    background: #f06a9b;
  }

  @media (min-width: 48rem) {
    .action-bar {
      display: none;
    }
  }
</style>
