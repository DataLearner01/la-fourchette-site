---
// Opening scene of the home page. See src/styles/scene.css for how it is laid out.
import '../styles/scene.css';
import { Image } from 'astro:assets';
import { routes, type Lang } from '../data/routes';

import facade from '../assets/hero/entree-facade.webp';
import leafLeft from '../assets/hero/porte-gauche.webp';
import leafRight from '../assets/hero/porte-droite.webp';
import room from '../assets/graded/hero-salle.jpg';

interface Props {
  lang: Lang;
  title: readonly string[];
  hint: string;
  tagline: string;
  primary: string;
  secondary: string;
  entranceAlt: string;
  roomAlt: string;
}
const { lang, title, hint, tagline, primary, secondary, entranceAlt, roomAlt } = Astro.props;
---

<section class="scene" data-scene data-theme="dark">
  <div class="scene__stage" data-scene-stage>
    <div class="scene__inside" data-scene-inside>
      <Image
        src={room}
        alt={roomAlt}
        widths={[720, 1080, 1440, 2000]}
        sizes="100vw"
        quality={78}
        loading="eager"
        fetchpriority="low"
        decoding="async"
      />
      <div class="scene__shade" data-scene-shade></div>
    </div>

    <div class="scene__world" data-scene-world>
      <div class="scene__doors" data-scene-doors>
        <img
          class="scene__leaf scene__leaf--left"
          data-scene-leaf="left"
          src={leafLeft.src}
          width={leafLeft.width}
          height={leafLeft.height}
          alt=""
        />
        <img
          class="scene__leaf scene__leaf--right"
          data-scene-leaf="right"
          src={leafRight.src}
          width={leafRight.width}
          height={leafRight.height}
          alt=""
        />
      </div>
      <img
        class="scene__facade"
        src={facade.src}
        width={facade.width}
        height={facade.height}
        alt={entranceAlt}
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="scene__scrim scene__scrim--start" data-scene-scrim="start"></div>
    <div class="scene__scrim scene__scrim--end" data-scene-scrim="end"></div>

    <div class="scene__ui wrap">
      <div class="scene__start" data-scene-start>
        <h1 class="scene__title">
          {
            title.map((line, i) => (
              <span class="scene__line" style={`--i:${i}`}>
                <span>{line} </span>
              </span>
            ))
          }
        </h1>
        <p class="scene__hint">{hint}</p>
      </div>

      <div class="scene__end" data-scene-end>
        <p class="scene__tagline">{tagline}</p>
        <div class="actions">
          <a class="btn" href={routes.reservation[lang]}>{primary}</a>
          <a class="link" href={routes.menu[lang]}>{secondary}</a>
        </div>
      </div>
    </div>

    <div class="scene__progress" aria-hidden="true"><span data-scene-progress></span></div>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const allowMotion = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && allowMotion) {
    const pick = <T extends HTMLElement>(selector: string) => scene.querySelector<T>(selector)!;
    const stage = pick('[data-scene-stage]');
    const world = pick('[data-scene-world]');
    const doors = pick('[data-scene-doors]');
    const leafLeft = pick('[data-scene-leaf="left"]');
    const leafRight = pick('[data-scene-leaf="right"]');
    const inside = pick('[data-scene-inside]');
    const shade = pick('[data-scene-shade]');
    const start = pick('[data-scene-start]');
    const end = pick('[data-scene-end]');
    const scrimStart = pick('[data-scene-scrim="start"]');
    const scrimEnd = pick('[data-scene-scrim="end"]');
    const bar = pick('[data-scene-progress]');

    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const span = (p: number, from: number, to: number) => clamp((p - from) / (to - from));
    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    // The scene finishes a little before the stage lets go, so the last frame holds.
    const PLAY_SHARE = 0.9;
    const DOOR_ANGLE = 84;

    let endScale = 1;
    let shiftX = 0;
    let shiftY = 0;
    let distance = 1;
    let pinTop = 0;
    let target = 0;
    let current = 0;
    let frameId = 0;

    function measure() {
      const stageWidth = stage.clientWidth;
      const stageHeight = stage.clientHeight;
      const doorWidth = doors.offsetWidth;
      const doorHeight = doors.offsetHeight;

      // Zoom until the doorway is well past the edges of the screen, so the open
      // door leaves have left the picture too, and bring it to the middle.
      endScale = Math.max(stageWidth / doorWidth, stageHeight / doorHeight) * 1.45;
      shiftX = stageWidth / 2 - (world.offsetLeft + doors.offsetLeft + doorWidth / 2);
      shiftY = stageHeight / 2 - (world.offsetTop + doors.offsetTop + doorHeight / 2);

      distance = Math.max(1, scene.offsetHeight - stage.offsetHeight);
      pinTop = parseFloat(getComputedStyle(stage).top) || 0;
    }

    function readScroll() {
      const scrolled = pinTop - scene.getBoundingClientRect().top;
      target = clamp(scrolled / (distance * PLAY_SHARE));
    }

    function render(p: number) {
      // Camera: walk toward the doorway.
      const zoom = easeInOut(span(p, 0, 0.88));
      world.style.transform = `translate3d(${shiftX * zoom}px, ${shiftY * zoom}px, 0) scale(${Math.pow(endScale, zoom)})`;
      world.style.opacity = String(1 - span(p, 0.85, 0.9));

      // Doors: swing inward.
      const open = easeInOut(span(p, 0.26, 0.7));
      leafLeft.style.transform = `rotateY(${open * DOOR_ANGLE}deg)`;
      leafRight.style.transform = `rotateY(${-open * DOOR_ANGLE}deg)`;
      // Dimmed per leaf: a filter on their shared parent would flatten the perspective.
      const dim = open > 0 ? `brightness(${1 - open * 0.45})` : '';
      leafLeft.style.filter = dim;
      leafRight.style.filter = dim;

      // Dining room: settles into place as the eyes adjust from the night outside.
      inside.style.transform = `scale(${1.24 - 0.24 * easeOut(span(p, 0.26, 0.95))})`;
      shade.style.opacity = String(0.5 * (1 - span(p, 0.4, 0.85)));

      // Opening words leave, closing words arrive.
      const leaving = span(p, 0, 0.3);
      start.style.opacity = String(1 - leaving);
      start.style.transform = `translate3d(0, ${leaving * -24}px, 0)`;
      start.style.filter = leaving > 0 ? `blur(${leaving * 10}px)` : '';
      scrimStart.style.opacity = String(1 - leaving);
      // Whichever set of words is showing is the one the pointer can reach.
      start.style.pointerEvents = leaving < 0.5 ? 'auto' : 'none';

      const arriving = span(p, 0.8, 0.98);
      end.style.opacity = String(arriving);
      end.style.transform = `translate3d(0, ${(1 - arriving) * 20}px, 0)`;
      end.style.filter = arriving < 1 ? `blur(${(1 - arriving) * 8}px)` : '';
      scrimEnd.style.opacity = String(arriving);
      end.style.pointerEvents = arriving > 0.5 ? 'auto' : 'none';

      bar.style.transform = `scaleX(${p})`;
    }

    // The picture eases toward the scroll position instead of snapping to it.
    function tick() {
      current += (target - current) * 0.16;
      if (Math.abs(target - current) < 0.0005) current = target;
      render(current);
      frameId = current === target ? 0 : requestAnimationFrame(tick);
    }

    function update() {
      readScroll();
      if (!frameId) frameId = requestAnimationFrame(tick);
    }

    function reset() {
      measure();
      readScroll();
      current = target;
      render(current);
    }

    reset();
    window.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(reset).observe(stage);
    // Returning with the back button restores the scroll position; match it.
    window.addEventListener('pageshow', reset);

    // Tabbing to the buttons before they have appeared jumps to the end of the scene.
    end.addEventListener('focusin', () => {
      if (current < 0.97) {
        window.scrollTo({ top: scene.offsetTop - pinTop + distance * PLAY_SHARE });
      }
    });
  }
</script>
