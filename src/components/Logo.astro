---
// Rebuilt logo: silver script wordmark, and the fork wearing its pink bow tie.
interface Props {
  tagline?: string;
  size?: 'header' | 'large';
}
const { tagline, size = 'header' } = Astro.props;
// The logo appears several times per page; each copy needs its own gradient id.
const gradientId = `fork-silver-${crypto.randomUUID().slice(0, 8)}`;
---

<span class:list={['logo', `logo--${size}`]}>
  <span class="logo__row">
    <span class="logo__word">La Fourchette</span>
    <svg class="logo__fork" viewBox="5 0 30 96" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id={gradientId} x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#8f9296"></stop>
          <stop offset="0.45" stop-color="#f4f4f5"></stop>
          <stop offset="1" stop-color="#a3a6aa"></stop>
        </linearGradient>
      </defs>
      <path
        fill={`url(#${gradientId})`}
        d="M14.5 4a.85.85 0 0 1 1.7 0V22h1.4V4a.85.85 0 0 1 1.7 0V22h1.4V4a.85.85 0 0 1 1.7 0V22h1.4V4a.85.85 0 0 1 1.7 0V25C25.5 31 21.4 33 21.3 38L21.6 60C21.8 70 23.2 78 23.2 86 23.2 91 21.8 94 20 94 18.2 94 16.8 91 16.8 86 16.8 78 18.2 70 18.4 60L18.7 38C18.6 33 14.5 31 14.5 25Z"
      ></path>
      <g class="logo__bow">
        <path fill="#e4477f" d="M20 42 8.6 36.2Q6.8 42 8.6 47.8ZM20 42 31.4 36.2Q33.2 42 31.4 47.8Z"></path>
        <rect fill="#c93a6d" x="17.9" y="39.4" width="4.2" height="5.2" rx="1.3"></rect>
      </g>
    </svg>
  </span>
  {tagline && <span class="logo__tagline">{tagline}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
  }

  .logo__row {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .logo__word {
    font-family: var(--font-script);
    font-size: 1em;
    /* Room for the script's swashes, which the gradient would otherwise clip. */
    padding: 0.18em 0.12em 0.12em 0.04em;
    background: linear-gradient(180deg, #ffffff 18%, #d5d7da 46%, #9b9ea3 58%, #ececed 82%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
  }

  .logo__fork {
    height: 1.25em;
    width: auto;
    flex: none;
  }

  /* The bow tie straightens itself when the logo is hovered. */
  .logo__bow {
    transform-box: view-box;
    transform-origin: 20px 42px;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .logo .logo__bow {
      animation: bow-wiggle 0.9s var(--ease);
    }
  }

  @keyframes bow-wiggle {
    20% {
      rotate: -14deg;
    }
    50% {
      rotate: 9deg;
    }
    75% {
      rotate: -4deg;
    }
  }

  .logo__tagline {
    margin-top: 0.5rem;
    font-family: var(--font-text);
    font-size: 0.95rem;
    font-weight: 350;
    letter-spacing: 0.04em;
    color: #d9dadc;
  }

  .logo--header {
    font-size: 1.7rem;
  }

  .logo--large {
    font-size: clamp(2.4rem, 6vw, 3.4rem);
  }

  @media (min-width: 68rem) {
    .logo--header {
      font-size: 2rem;
    }
  }
</style>
