---
// Pointer interactions, for devices with a mouse or trackpad only:
//   - a small ring that trails the pointer and opens up over anything clickable
//   - buttons that lean slightly toward the pointer
//   - headings and names that cast a soft shadow away from it
// None of it runs on touch screens or when reduced motion is requested,
// and the system pointer always stays visible.
---

<div class="cursor" data-cursor aria-hidden="true"></div>

<script>
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine) {
    // --- Shadow cast by headings and names -------------------------------
    document.addEventListener(
      'pointermove',
      (event) => {
        const text =
          event.target instanceof Element ? event.target.closest<HTMLElement>('h1, h2, h3, .cast') : null;
        if (!text) return;
        const box = text.getBoundingClientRect();
        const x = (box.left + box.width / 2 - event.clientX) / (box.width / 2);
        const y = (box.top + box.height / 2 - event.clientY) / (box.height / 2);
        text.style.setProperty('--cast-x', (x * 9).toFixed(1));
        text.style.setProperty('--cast-y', (y * 5 + 4).toFixed(1));
      },
      { passive: true },
    );
  }

  if (fine && !calm) {
    // --- Trailing ring ---------------------------------------------------
    const ring = document.querySelector<HTMLElement>('[data-cursor]')!;
    const clickable = 'a, button, [role="tab"], summary, label';
    const typing = 'input:not([type="radio"]), textarea, select';
    let targetX = 0;
    let targetY = 0;
    let x = 0;
    let y = 0;
    let frame = 0;

    const step = () => {
      x += (targetX - x) * 0.2;
      y += (targetY - y) * 0.2;
      ring.style.transform = `translate3d(${x.toFixed(1)}px, ${y.toFixed(1)}px, 0)`;
      frame = Math.abs(targetX - x) + Math.abs(targetY - y) > 0.2 ? requestAnimationFrame(step) : 0;
    };

    document.addEventListener(
      'pointermove',
      (event) => {
        if (event.pointerType !== 'mouse') return;
        targetX = event.clientX;
        targetY = event.clientY;
        if (!ring.classList.contains('is-on')) {
          // First sight of the pointer: start where it is instead of flying in.
          x = targetX;
          y = targetY;
          ring.classList.add('is-on');
        }
        const over = event.target instanceof Element ? event.target : null;
        ring.classList.toggle('is-open', Boolean(over?.closest(clickable)));
        ring.classList.toggle('is-away', Boolean(over?.closest(typing)));
        if (!frame) frame = requestAnimationFrame(step);
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', () => ring.classList.remove('is-on'));
    document.addEventListener('pointerdown', () => ring.classList.add('is-down'));
    document.addEventListener('pointerup', () => ring.classList.remove('is-down'));

    // --- Buttons lean toward the pointer ---------------------------------
    document.querySelectorAll<HTMLElement>('.btn').forEach((button) => {
      button.addEventListener('pointermove', (event) => {
        const box = button.getBoundingClientRect();
        const dx = event.clientX - (box.left + box.width / 2);
        const dy = event.clientY - (box.top + box.height / 2);
        button.style.translate = `${(dx * 0.16).toFixed(1)}px ${(dy * 0.28).toFixed(1)}px`;
      });
      button.addEventListener('pointerleave', () => {
        button.style.translate = '';
      });
    });
  }
</script>

<style>
  .cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 200;
    width: 0.7rem;
    height: 0.7rem;
    translate: -50% -50%;
    border: 1px solid #fff;
    border-radius: 50%;
    /* Inverts whatever is beneath it, so it shows on black and on white alike. */
    mix-blend-mode: difference;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.3s ease,
      width 0.45s var(--ease),
      height 0.45s var(--ease),
      background-color 0.3s ease;
    will-change: transform;
  }

  .cursor.is-on {
    opacity: 0.85;
  }

  /* Over anything clickable the ring opens up around the pointer. */
  .cursor.is-open {
    width: 2.6rem;
    height: 2.6rem;
    background-color: rgb(255 255 255 / 0.1);
  }

  .cursor.is-open.is-down {
    width: 2.1rem;
    height: 2.1rem;
  }

  /* Out of the way while typing. */
  .cursor.is-away {
    opacity: 0;
  }

  @media not ((hover: hover) and (pointer: fine)) {
    .cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      display: none;
    }
  }
</style>