---
import Inner from './Inner.astro';
import MenuTabs from '../components/MenuTabs.astro';
import ReserveBand from '../components/ReserveBand.astro';
import type { Lang } from '../data/routes';
import { pages } from '../content/pages';
import { foodMenu, foodMenuNote } from '../content/menu';

import avocat from '../assets/graded/avocat-crevettes.jpg';
import magret from '../assets/graded/magret-plantain.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = pages.menu[lang];

// Only the dishes that were actually photographed get a picture.
const pictures = {
  entrees: { src: avocat, alt: t.alts.entrees, caption: t.captions.entrees },
  plats: { src: magret, alt: t.alts.plats, caption: t.captions.plats, position: '58% 50%' },
};
---

<Inner lang={lang} page="menu" theme="dark" words={t.words}>
  <MenuTabs
    lang={lang}
    label={t.tabsLabel}
    categories={foodMenu}
    pictures={pictures}
    note={foodMenuNote}
    theme="light"
  />
  <ReserveBand lang={lang} />
</Inner>
