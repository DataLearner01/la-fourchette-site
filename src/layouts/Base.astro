---
import '../styles/fonts.css';
import '../styles/global.css';
import '../styles/blocks.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ActionBar from '../components/ActionBar.astro';
import Pointer from '../components/Pointer.astro';
import { routes, otherLang, defaultLang, langs, type Lang, type PageKey } from '../data/routes';
import { common, venue } from '../data/site';
import { mapsUrl } from '../content/shared';

// The two text fonts on every first screen are fetched early, alongside the page.
import bodoniFile from '../../node_modules/@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import jostFile from '../../node_modules/@fontsource-variable/jost/files/jost-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  // null on pages outside the six tabs, such as the 404 page.
  page: PageKey | null;
  title: string;
  description: string;
  // Pages that should stay out of search results (the 404 page).
  noindex?: boolean;
}
const { lang, page, title, description, noindex = false } = Astro.props;

const absolute = (path: string) => new URL(path, Astro.site).href;
const alternatePath = routes[page ?? 'home'][otherLang(lang)];
const canonical = page ? absolute(routes[page][lang]) : null;
const shareImage = absolute('/og.jpg');

// Search-engine description of the restaurant. Only verified facts: the phone
// number and opening hours are demo values and are deliberately left out.
const restaurant = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: venue.name,
  url: absolute(routes.home[lang]),
  image: shareImage,
  address: {
    '@type': 'PostalAddress',
    streetAddress: venue.street,
    addressLocality: venue.city,
    addressCountry: 'CM',
  },
  servesCuisine: ['Cameroonian', 'French', 'Italian', 'Chinese'],
  acceptsReservations: true,
  hasMenu: absolute(routes.menu[lang]),
  hasMap: mapsUrl,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={bodoniFile} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jostFile} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {canonical && <link rel="canonical" href={canonical} />}
    {
      page &&
        langs.map((code) => <link rel="alternate" hreflang={code} href={absolute(routes[page][code])} />)
    }
    {page && <link rel="alternate" hreflang="x-default" href={absolute(routes[page][defaultLang])} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={venue.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_GB'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(restaurant)} />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script is:inline define:vars={{ alternatePath, isDefaultLang: lang === 'fr' && page !== null }}>
      // French is the default. A browser set to English opens the English page,
      // until the visitor picks a language with the switch: that choice then wins.
      try {
        if (isDefaultLang) {
          const choice = localStorage.getItem('lf-lang');
          const wantsEnglish = choice ? choice === 'en' : /^en\b/i.test(navigator.language || '');
          if (wantsEnglish) location.replace(alternatePath + location.hash);
        }
      } catch (error) {}
    </script>
  </head>
  <body data-theme="dark">
    <a class="skip-link" href="#contenu">{common[lang].skip}</a>
    <Header lang={lang} page={page} />
    <main id="contenu">
      <slot />
    </main>
    <Footer lang={lang} page={page} />
    <ActionBar lang={lang} page={page} />
    <Pointer />
  </body>
</html>
